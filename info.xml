<?xml version="1.0"?>
<extension key="wpcvquicksearch" type="module">
  <file>wpcvquicksearch</file>
  <name>WPCV Quick Search</name>
  <description>A CiviCRM SearchKit autocomplete display built for the quick search feature in the WPCV Admin Wordpress plugin</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Andy Burns</name>
      <email>andy@civicopilot.com</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/civicopilot/wpcvquicksearch</url>
    <url desc="Documentation">https://github.com/civicopilot/wpcvquicksearch</url>
    <url desc="Support">https://github.com/civicopilot/wpcvquicksearch/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-27</releaseDate>
  <version>1.0.0</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>6.17.0</ver>
  </compatibility>
  <comments>After enabling this extension, you will see a search under the "Packaged Searches" section of SearchKit</comments>
  <civix>
    <namespace>CRM/Wpcvquicksearch</namespace>
    <format>25.01.1</format>
  </civix>
  <mixins>
    <mixin>mgd-php@1.0.0</mixin>
  </mixins>
</extension>
